            <name>HKEY_LOCAL_MACHINE\SOFTWARE\NVIDIA Corporation\Installer\DisplayDriverVersion\</name>
            <value>385.08</value>
            <displayName>HKEY_LOCAL_MACHINE\SOFTWARE\NVIDIA Corporation\Installer\Display\</displayName>
            <displayValue>"Display Driver"</displayValue>
        </registrykey>
      </registrykeys>
